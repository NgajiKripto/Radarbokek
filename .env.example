# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/radarbokek

# JWT — MUST be changed to a random string (min 32 chars)
JWT_SECRET=change-me-to-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Webhook — shared secret for payment gateway signature verification
WEBHOOK_SECRET=change-me-webhook-secret-min-32-chars

# Server
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173
